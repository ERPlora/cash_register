{
  "id": "cash_register",
  "name": "Cash Register",
  "version": "1.3.32",
  "description": "Open and close register sessions, record cash in and out, and reconcile the drawer at closing.",
  "agent": {
    "description": "Manages cash register sessions, cash movements, and drawer counts: open/close sessions, record cash in/out, perform cash counts, and list register activity.",
    "keywords": [
      "cash register",
      "session",
      "drawer",
      "cash movement",
      "till",
      "cash count",
      "pos"
    ]
  },
  "depends_on": [],
  "permissions": [
    "cash_register.view_session",
    "cash_register.add_session",
    "cash_register.close_session",
    "cash_register.view_movement",
    "cash_register.add_movement",
    "cash_register.view_count",
    "cash_register.add_count",
    "cash_register.view_reports",
    "cash_register.manage_settings",
    "cash_register.view_expected_totals"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "cashier": [
      "cash_register.view_session",
      "cash_register.add_session",
      "cash_register.close_session",
      "cash_register.view_movement",
      "cash_register.add_movement",
      "cash_register.view_count",
      "cash_register.add_count"
    ],
    "manager": [
      "cash_register.view_session",
      "cash_register.add_session",
      "cash_register.close_session",
      "cash_register.view_movement",
      "cash_register.add_movement",
      "cash_register.view_count",
      "cash_register.add_count",
      "cash_register.view_reports",
      "cash_register.view_expected_totals"
    ],
    "employee": [
      "cash_register.view_session",
      "cash_register.add_session",
      "cash_register.close_session",
      "cash_register.view_movement",
      "cash_register.add_movement",
      "cash_register.view_count",
      "cash_register.add_count",
      "cash_register.view_reports"
    ]
  },
  "navigation": [
    {
      "id": "cash_register",
      "label": "Cash Register",
      "icon": "cash-outline",
      "component": "erp-cashregister-dashboard"
    }
  ],
  "protects": [
    {
      "settings_query": "cash_register.settings.get",
      "enabled_setting": "enable_cash_register",
      "route_setting": "protected_pos_url",
      "guard_query": "cash_register.current_session",
      "expect": "non_empty",
      "component": "erp-cashregister-open",
      "resume_on": "cash_register.session_opened"
    }
  ],
  "settings": {
    "title": "Caja",
    "icon": "cash-outline",
    "schema": "schemas/settings_update.json",
    "get": "cash_register.settings.get",
    "set": "cash_register.settings.update"
  },
  "setup": {
    "query": "cash_register.settings.get",
    "configured_when": [
      {
        "field": "id",
        "truthy": true
      }
    ],
    "title": "Your cash drawer",
    "description": "Decide how the till opens and closes: the opening float, the closing count and the POS screen that stays locked until the drawer is open.",
    "icon": "cash-outline",
    "route": "/m/cash_register/settings",
    "permission": "cash_register.manage_settings",
    "countries": [],
    "order": 90,
    "required": false
  },
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql",
      "migrations/postgres/002_gift_total.sql",
      "migrations/postgres/003_payment_method_type.sql",
      "migrations/postgres/004_one_open_session_per_hub.sql",
      "migrations/postgres/005_require_blind_count.sql",
      "migrations/postgres/006_auto_close.sql",
      "migrations/postgres/007_session_counter.sql"
    ]
  },
  "queries": {
    "cash_register.sessions.list": {
      "permission": "cash_register.view_session",
      "sql": "queries/sessions_list.sql",
      "list": {
        "search": [
          "session_number"
        ],
        "sort": [
          "id",
          "session_number",
          "status",
          "register_id",
          "opened_at",
          "opening_balance",
          "closed_at",
          "closing_balance",
          "expected_balance",
          "difference"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "session_number": {
            "op": "eq"
          },
          "status": {
            "op": "eq"
          },
          "register_id": {
            "op": "eq"
          },
          "opened_at": {
            "op": "range"
          },
          "opening_balance": {
            "op": "range"
          },
          "closed_at": {
            "op": "range"
          },
          "closing_balance": {
            "op": "range"
          },
          "expected_balance": {
            "op": "range"
          },
          "difference": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists all cash register sessions with their status and totals"
      }
    },
    "cash_register.session.summary": {
      "permission": "cash_register.view_session",
      "sql": "queries/session_summary.sql",
      "ai": {
        "description": "Returns the totals and movement summary for a specific cash register session"
      }
    },
    "cash_register.movements.list": {
      "permission": "cash_register.view_movement",
      "sql": "queries/movements_list.sql",
      "list": {
        "search": [
          "sale_reference",
          "description"
        ],
        "sort": [
          "id",
          "movement_type",
          "amount",
          "payment_method",
          "sale_reference",
          "description",
          "created_at"
        ],
        "default_sort": "created_at",
        "default_dir": "desc",
        "filters": {
          "movement_type": {
            "op": "eq"
          },
          "amount": {
            "op": "range"
          },
          "payment_method": {
            "op": "eq"
          },
          "sale_reference": {
            "op": "eq"
          },
          "description": {
            "op": "like"
          },
          "created_at": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists all cash movements (in/out) for a given register session"
      }
    },
    "cash_register.counts.list": {
      "permission": "cash_register.view_count",
      "sql": "queries/counts_list.sql",
      "list": {
        "sort": [
          "id",
          "count_type",
          "total",
          "denominations",
          "notes",
          "counted_at"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "count_type": {
            "op": "range"
          },
          "total": {
            "op": "range"
          },
          "denominations": {
            "op": "eq"
          },
          "notes": {
            "op": "like"
          },
          "counted_at": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists cash counts (till counts) performed on a register"
      }
    },
    "cash_register.settings.get": {
      "permission": "cash_register.view_session",
      "sql": "queries/settings_get.sql",
      "schema": "schemas/settings_get.json",
      "ai": {
        "description": "Retrieves the cash register settings for the hub (toggles and protected POS URL)"
      }
    },
    "cash_register.registers.list": {
      "permission": "cash_register.view_session",
      "sql": "queries/registers_list.sql",
      "list": {
        "search": [
          "name"
        ],
        "sort": [
          "id",
          "name",
          "is_active"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "like"
          },
          "is_active": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the available cash registers configured in the system"
      }
    },
    "cash_register.current_session": {
      "permission": "cash_register.view_session",
      "sql": "queries/current_session.sql",
      "ai": {
        "description": "Returns the currently open cash register session for the hub. Includes its expected cash total (opening balance + net cash movements) unless the blind-count setting is on. Empty if no session is open."
      }
    },
    "cash_register.current_session.expected": {
      "permission": "cash_register.view_expected_totals",
      "sql": "queries/current_session_expected.sql",
      "ai": {
        "description": "Returns the currently open cash register session with its expected cash total (opening balance + net cash movements), for supervisors — not subject to the blind-count setting. Empty if no session is open."
      }
    }
  },
  "widgets": {
    "cash_register.current_session": {
      "title": "Cash register (current session)",
      "icon": "cash-outline",
      "category": "Caja",
      "size": "sm",
      "permission": "cash_register.view_expected_totals",
      "sectors": [
        "retail",
        "hosteleria"
      ],
      "default": true,
      "kind": "kpi",
      "query": "cash_register.current_session.expected",
      "refresh_on": [
        "cash_register.movement_added",
        "cash_register.session_opened",
        "cash_register.session_closed"
      ],
      "map": {
        "value": "expected_total"
      },
      "options": {
        "label": "Expected cash in drawer",
        "icon": "cash-outline",
        "format": "currency",
        "currency": "EUR",
        "locale": "es-ES"
      }
    },
    "cash_register.recent_sessions": {
      "title": "Recent discrepancies",
      "icon": "swap-vertical-outline",
      "category": "Caja",
      "size": "md",
      "permission": "cash_register.view_reports",
      "sectors": [
        "retail",
        "hosteleria"
      ],
      "default": false,
      "kind": "bar-list",
      "query": "cash_register.sessions.list",
      "refresh_on": [
        "cash_register.session_opened",
        "cash_register.session_closed"
      ],
      "params": {
        "status": "closed",
        "sort": "closed_at",
        "dir": "desc",
        "limit": 8
      },
      "map": {
        "label": "session_number",
        "value": "difference"
      },
      "options": {
        "valueFormat": "currency",
        "currency": "EUR",
        "locale": "es-ES"
      }
    }
  },
  "commands": {
    "cash_register.registers.create": {
      "permission": "cash_register.manage_settings",
      "transaction": true,
      "sql": [
        "commands/register_create.sql"
      ],
      "ai": {
        "description": "Creates a new cash register"
      }
    },
    "cash_register.settings.update": {
      "permission": "cash_register.manage_settings",
      "transaction": true,
      "sql": [
        "commands/settings_update.sql"
      ],
      "schema": "schemas/settings_update.json",
      "emit": [
        "cash_register.settings_updated"
      ],
      "ai": {
        "description": "Updates the cash register settings (upsert of the per-hub singleton row)"
      }
    },
    "cash_register.session.open": {
      "permission": "cash_register.add_session",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "open_session"
      },
      "schema": "schemas/open_session.json",
      "reads": [
        {
          "query": "cash_register.settings.get",
          "required": true
        },
        {
          "query": "cash_register.current_session",
          "required": true
        }
      ],
      "emit": [
        "cash_register.session_opened"
      ],
      "ai": {
        "description": "Opens a new cash register session with the specified opening float. Fails with cash_register.session_already_open if the hub already has an open session, and with cash_register.opening_balance_required when the settings require a float and none is given."
      }
    },
    "cash_register._bump_counter": {
      "permission": "cash_register.add_session",
      "sql": [
        "commands/_bump_counter.sql"
      ]
    },
    "cash_register._open_session_insert": {
      "permission": "cash_register.add_session",
      "transaction": true,
      "sql": [
        "commands/open_session.sql"
      ]
    },
    "cash_register.session.close": {
      "permission": "cash_register.close_session",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "close_session"
      },
      "reads": [
        {
          "query": "cash_register.settings.get",
          "required": true
        }
      ],
      "emit": [
        "cash_register.session_closed"
      ],
      "ai": {
        "description": "Closes the active cash register session and records the final cash amount. Fails with cash_register.closing_balance_required when the settings require the drawer to be counted and no closing_balance is given."
      }
    },
    "cash_register._close_session_apply": {
      "permission": "cash_register.close_session",
      "transaction": true,
      "sql": [
        "commands/close_session.sql"
      ]
    },
    "cash_register._auto_close_sessions": {
      "permission": "cash_register.close_session",
      "transaction": true,
      "sql": [
        "commands/_auto_close_sessions.sql"
      ],
      "emit": [
        "cash_register.session_closed"
      ]
    },
    "cash_register.movement.add": {
      "permission": "cash_register.add_movement",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "add_movement"
      },
      "schema": "schemas/add_movement.json",
      "reads": [
        {
          "query": "cash_register.settings.get",
          "required": true
        },
        {
          "query": "cash_register.session.summary",
          "params": {
            "session_id": "payload.session_id"
          },
          "required": true
        }
      ],
      "emit": [
        "cash_register.movement_added"
      ],
      "ai": {
        "description": "Records a cash movement against an open register session. `movement_type` says WHAT the movement is (`in` cash into the drawer, `out` cash taken out, `sale`, `refund`) and `amount` says HOW MUCH, in minor units and ALWAYS POSITIVE (30.00 EUR = 3000): the server applies the sign, storing outflows negative. Fails with cash_register.session_unavailable if the session is not this business's, cash_register.movement_type_unknown for any other type, cash_register.amount_required for a zero amount, and cash_register.negative_balance_not_allowed when a cash-out would leave the drawer below zero and the settings forbid it."
      }
    },
    "cash_register._movement_insert": {
      "permission": "cash_register.add_movement",
      "transaction": true,
      "sql": [
        "commands/add_movement.sql"
      ]
    },
    "cash_register.count.add": {
      "permission": "cash_register.add_count",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "add_count"
      },
      "schema": "schemas/add_count.json",
      "ai": {
        "description": "Performs a cash count by recording the number of each denomination in the drawer"
      }
    },
    "cash_register.record_sale": {
      "permission": "cash_register.add_movement",
      "emit": [
        "cash_register.movement_added"
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "record_sale"
      },
      "ai": {
        "description": "Records the cash movement corresponding to a completed sale"
      }
    },
    "cash_register._insert_count": {
      "permission": "cash_register.add_count",
      "sql": [
        "commands/_insert_count.sql"
      ]
    },
    "cash_register._movement_for_open_session": {
      "permission": "cash_register.add_movement",
      "sql": [
        "commands/_movement_for_open_session.sql"
      ]
    },
    "cash_register._reverse_sale": {
      "permission": "cash_register.add_movement",
      "transaction": true,
      "sql": [
        "commands/_reverse_sale.sql"
      ],
      "emit": [
        "cash_register.movement_added"
      ]
    }
  },
  "events": {
    "listen": {
      "sale.completed": {
        "command": "cash_register.record_sale"
      },
      "sale.voided": {
        "command": "cash_register._reverse_sale"
      }
    },
    "emits": [
      "cash_register.movement_added",
      "cash_register.session_closed",
      "cash_register.session_opened",
      "cash_register.settings_updated"
    ]
  },
  "scheduled_tasks": [
    {
      "name": "auto_close_sessions",
      "command": "cash_register._auto_close_sessions",
      "cron": "*/5 * * * *",
      "catch_up": "collapse"
    }
  ],
  "ui": {
    "entry": "dist/cash_register.esm.js"
  }
}
